#!/bin/sh
set -eu

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File scripts/check-sensitive-files.ps1 -Mode Staged
fi

if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-sensitive-files.ps1 -Mode Staged
fi

echo "PowerShell was not found; cannot run sensitive file guard." >&2
exit 1
